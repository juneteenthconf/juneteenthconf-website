rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Lock down pending_subscriptions so public clients can't read or write to it.
    // Our backend Cloud Functions bypass this block automatically.
    match /pending_subscriptions/{email} {
      allow read, write: if false;
    }
    
    // If you have other collections in your project, their rules go here.
    // For example, to deny public access to everything else by default:
    // match /{document=**} {
    //   allow read, write: if false;
    // }
  }
}

---
interface Props {
  current?: string;
}
const { current } = Astro.props;
const b = import.meta.env.BASE_URL;
const base = b.endsWith('/') ? b : b + '/';

const links = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}conference/`, label: 'Conference' },
  { href: `${base}conference/speakers/`, label: 'Speakers' },
  { href: `${base}conference/schedule/`, label: 'Schedule' },
  { href: `${base}about/board/`, label: 'Board' },
  { href: `${base}juneteenth/`, label: 'Juneteenth' },
  { href: `${base}volunteer/`, label: 'Volunteer' },
];
---

<nav class="interior-nav" aria-label="Site navigation">
  <a href={base} class="interior-nav-brand" aria-label="JuneteenthConf home">
    <img src={`${base}logo-white.png`} alt="JuneteenthConf" class="nav-logo" width="140" height="50" />
  </a>
  <div class="interior-nav-links">
    {links.map(link => (
      link.label === current
        ? <span class="interior-nav-current">{link.label}</span>
        : <a href={link.href}>{link.label}</a>
    ))}
    <!-- Register CTA removed -->
  </div>
  <button class="hamburger-btn" id="hamburger-interior" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu-interior" hidden>
  {links.map(link => (
    <a href={link.href} class={link.label === current ? 'mobile-menu-current' : ''}>{link.label}</a>
  ))}
  <!-- Register CTA removed -->
</div>

<style>
  .interior-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 997;
    background: rgba(35, 28, 45, 0.95); backdrop-filter: blur(16px);
    padding: 14px 24px; display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid rgba(212, 168, 67, 0.12);
  }
  .interior-nav-brand {
    color: #f0ede6; text-decoration: none; display: flex; align-items: center;
  }
  .nav-logo { height: 36px; width: auto; display: block; }
  .interior-nav-brand:hover { opacity: 0.85; }
  .interior-nav-links {
    display: flex; gap: 20px; align-items: center;
  }
  .interior-nav-links a {
    color: rgba(240, 237, 230, 0.5); text-decoration: none;
    font-family: 'Inter', sans-serif; font-size: 13px;
    transition: color 0.2s;
  }
  .interior-nav-links a:hover { color: #f0ede6; }
  .interior-nav-current {
    color: #D4A843; font-family: 'Inter', sans-serif;
    font-size: 13px; font-weight: 600;
  }
  .interior-nav-cta {
    background: #b53a39 !important; color: #fff !important;
    padding: 6px 16px; border-radius: 4px;
    font-family: 'Space Grotesk', sans-serif !important;
    font-weight: 600 !important; font-size: 12px !important;
    letter-spacing: 1px; text-transform: uppercase;
  }
  .interior-nav-cta:hover { background: #a33231 !important; }

  /* Hamburger */
  .hamburger-btn {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    background: none; border: none; cursor: pointer; padding: 6px;
    width: 36px; height: 36px;
  }
  .hamburger-btn span {
    display: block; width: 22px; height: 2px;
    background: rgba(240, 237, 230, 0.75);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .hamburger-btn.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger-btn.is-open span:nth-child(2) { opacity: 0; }
  .hamburger-btn.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    position: fixed; top: 65px; left: 0; right: 0; z-index: 996;
    background: rgba(35, 28, 45, 0.98); backdrop-filter: blur(16px);
    padding: 8px 24px 24px;
    display: flex; flex-direction: column;
    border-bottom: 1px solid rgba(212, 168, 67, 0.15);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a {
    color: rgba(240, 237, 230, 0.65); text-decoration: none;
    font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: color 0.15s;
  }
  .mobile-menu a:hover { color: #f0ede6; }
  .mobile-menu-current { color: #D4A843 !important; font-weight: 600 !important; }
  .mobile-menu-cta {
    margin-top: 16px;
    background: #b53a39 !important; color: #fff !important;
    text-align: center; padding: 13px 0 !important;
    border-radius: 6px; border: none !important;
    font-family: 'Space Grotesk', sans-serif !important;
    font-weight: 700 !important; font-size: 14px !important;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .mobile-menu-cta:hover { background: #a33231 !important; }

  @media (max-width: 768px) {
    .interior-nav-links a:not(.interior-nav-cta),
    .interior-nav-current { display: none; }
    .interior-nav-links { gap: 12px; }
    .hamburger-btn { display: flex; }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-interior') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu-interior') as HTMLElement;

  btn.addEventListener('click', () => {
    const open = !menu.hidden;
    menu.hidden = open;
    btn.setAttribute('aria-expanded', String(!open));
    btn.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });

  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.hidden = true;
    btn.classList.remove('is-open');
    document.body.style.overflow = '';
  }));
</script>

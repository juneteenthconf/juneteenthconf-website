---
const b = import.meta.env.BASE_URL;
const base = b.endsWith('/') ? b : b + '/';
---

<section class="scene scene-opening hero-split" id="conf-info">
  <!-- Left: logo + content -->
  <div class="hero-content">
    <p class="reveal font-display hero-sub">
      Juneteenth Conference returns to Chicago in 2026
    </p>
    <p class="reveal font-display hero-date">
      June 19th &amp; 20th
    </p>
    <p class="reveal hero-location">
      <a href="https://maps.google.com/?q=200+E+Randolph+Dr+Suite+200+Chicago+IL+60601" target="_blank" rel="noopener" class="hero-location-link">Microsoft Chicago &bull; 200 E. Randolph Dr., Suite 200 &bull; Chicago, IL 60601</a>
    </p>

    <div class="reveal hero-details">
      <div class="hero-detail-item">
        <span class="hero-detail-day">Day 1</span>
        <span class="hero-detail-desc">Conference Sessions</span>
      </div>
      <div class="hero-detail-divider" aria-hidden="true"></div>
      <div class="hero-detail-item">
        <span class="hero-detail-day">Day 2</span>
        <span class="hero-detail-desc">AI Workshop &amp; Hackathon</span>
      </div>
    </div>

    <div class="reveal hero-ctas">
      <a href={`${base}conference/register/`} class="cta-primary">Register</a>
      <a href={`${base}conference/sponsor/`} class="cta-outline">Sponsor</a>
    </div>
  </div>

  <!-- Right: full-bleed illustration -->
  <div class="hero-illustration-wrap" aria-hidden="true">
    <img
      src={`${base}illustration.png`}
      alt=""
      fetchpriority="high"
      loading="eager"
      class="hero-illustration"
      width="541"
      height="1000"
    />
  </div>

  <div class="scroll-prompt">
    <p class="font-body" style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; opacity: 0.4;">Scroll down to learn more</p>
    <div style="margin-top: 12px; font-size: 20px; opacity: 0.4;">&#8595;</div>
  </div>
</section>

<style>
  .hero-split {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    padding: 0;
    min-height: 100vh;
    overflow: hidden;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 48px 80px 64px;
    max-width: 600px;
    position: relative;
    z-index: 2;
  }

  .hero-sub {
    font-size: clamp(18px, 2.5vw, 28px);
    font-weight: 400;
    line-height: 1.5;
    color: rgba(240, 237, 230, 0.8);
    letter-spacing: -0.3px;
    margin-bottom: 16px;
  }

  .hero-date {
    font-size: clamp(32px, 4.5vw, 60px);
    font-weight: 700;
    color: #D4A843;
    letter-spacing: -1.5px;
    line-height: 1.1;
    margin-bottom: 48px;
  }

  .hero-location {
    font-family: 'Inter', sans-serif;
    font-size: 14px; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(240, 237, 230, 0.45);
    margin-bottom: 32px;
    margin-top: -20px;
  }
  .hero-location-link {
    color: inherit; text-decoration: none;
    transition: color 0.2s;
  }
  .hero-location-link:hover { color: rgba(240, 237, 230, 0.8); }

  .hero-details {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 36px;
    flex-wrap: wrap;
    row-gap: 12px;
  }
  .hero-detail-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0 20px;
  }
  .hero-detail-item:first-child { padding-left: 0; }
  .hero-detail-day {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(240, 237, 230, 0.35);
  }
  .hero-detail-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px; font-weight: 500;
    color: rgba(240, 237, 230, 0.75);
  }
  .hero-detail-divider {
    width: 1px; height: 32px;
    background: rgba(240, 237, 230, 0.12);
    flex-shrink: 0;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cta-speak { border-color: rgba(212, 168, 67, 0.4); color: #D4A843; }
  .cta-speak:hover { border-color: #D4A843; color: #f0ede6; }

  .hero-illustration-wrap {
    position: absolute;
    right: 0;
    bottom: 0;
    top: 0;
    width: 45%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    pointer-events: none;
  }

  .hero-illustration {
    height: 105%;
    width: auto;
    object-fit: contain;
    object-position: bottom right;
    display: block;
    filter: drop-shadow(-24px 0 48px rgba(0,0,0,0.5));
  }

  .scroll-prompt {
    position: absolute;
    bottom: 32px;
    left: 64px;
    text-align: left;
  }

  @media (max-width: 768px) {
    .hero-split {
      flex-direction: column;
      align-items: center;
      padding: 80px 24px 80px;
    }
    .hero-content {
      padding: 0;
      max-width: 100%;
      align-items: center;
      text-align: center;
    }
    .hero-logo-link { margin-bottom: 32px; }
    .hero-illustration-wrap {
      display: none;
    }
    .scroll-prompt { left: 50%; transform: translateX(-50%); text-align: center; }
  }
</style>

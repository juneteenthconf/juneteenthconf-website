<section class="scene scene-opening" id="conf-info" style="min-height: 100vh; flex-direction: column;">
  <div style="position: absolute; top: 60px; left: 32px;">
    <div class="illustration-badge reveal" aria-label="JuneteenthConf logo">JC</div>
  </div>

  <div style="text-align: center; max-width: 700px; position: relative; z-index: 1;">
    <p class="reveal font-display" style="font-size: clamp(22px, 4vw, 36px); font-weight: 400; line-height: 1.5; color: rgba(240, 237, 230, 0.85); letter-spacing: -0.5px;">
      Juneteenth Conference returns to Chicago in 2026
    </p>
    <p class="reveal font-display" style="font-size: clamp(28px, 5vw, 48px); font-weight: 700; color: #D4A843; margin-top: 16px; letter-spacing: -1px;">
      June 19th &amp; 20th
    </p>

    <div class="reveal" style="display: flex; gap: 16px; justify-content: center; margin-top: 40px;">
      <a href="/conference/register/" class="cta-primary">Register</a>
      <a href="/conference/sponsor/" class="cta-outline">Sponsor</a>
    </div>
  </div>

  <div class="scroll-prompt" style="position: absolute; bottom: 40px; text-align: center;">
    <p class="font-body" style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; opacity: 0.4;">Scroll to begin</p>
    <div style="margin-top: 12px; font-size: 20px; opacity: 0.4;">&#8595;</div>
  </div>
</section>

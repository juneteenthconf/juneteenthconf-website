---
const b = import.meta.env.BASE_URL;
const base = b.endsWith('/') ? b : b + '/';
const programs = [
  {
    name: 'Conference',
    color: '#c84342',
    description: 'Two days. 20 curated sessions across engineering, data, security, entrepreneurship, and tech leadership.',
    href: `${base}conference/`,
  },
  {
    name: 'Accelerator',
    color: '#55ac64',
    description: 'Hands-on project experience, mentorship, and career pipeline support for Black professionals entering or advancing in tech.',
    href: `${base}about/programs/`,
  },
  {
    name: 'Mentorship',
    color: '#D4A843',
    description: 'Pairing aspiring technologists with experienced professionals for upskilling, portfolio building, and career guidance.',
    href: `${base}about/programs/`,
  },
];
---

<section class="scene" id="table" style="min-height: auto; background: linear-gradient(180deg, #2d2438, #231c2d);">
  <div style="max-width: 1100px; margin: 0 auto; width: 100%; position: relative; z-index: 2;">
    {programs.map((prog, i) => (
      <>
        <div class="reveal program-block" style={i < programs.length - 1 ? 'margin-bottom: 80px;' : ''}>
          <h2 class="type-outlined" style={`font-size: clamp(48px, 10vw, 120px); -webkit-text-stroke-color: ${prog.color}; flex-shrink: 0;`}>{prog.name}</h2>
          <div style="max-width: 400px;">
            <p style="font-family: 'Inter', sans-serif; font-size: clamp(14px, 1.5vw, 17px); color: rgba(255,255,255,0.5); line-height: 1.7; padding-bottom: 12px;">{prog.description}</p>
            <a href={prog.href} style="font-family: 'Space Grotesk', sans-serif; font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.35); text-decoration: none; letter-spacing: 0.1em; text-transform: uppercase; transition: color 0.2s;" onmouseover="this.style.color='{prog.color}'" onmouseout="this.style.color='rgba(255,255,255,0.35)'">Learn more &rarr;</a>
          </div>
        </div>
        {i < programs.length - 1 && (
          <div class="line-divider" style={`color: ${programs[i + 1].color}; margin-bottom: 80px;`}></div>
        )}
      </>
    ))}
  </div>
</section>

---
import CommunitySignup from '../CommunitySignup.astro';
const b = import.meta.env.BASE_URL;
const base = b.endsWith('/') ? b : b + '/';
---

<section class="scene scene-invitation" id="register" style="min-height: 100vh;">
  <div style="text-align: center; max-width: 1000px; margin: 0 auto; position: relative; z-index: 2;">
    <div class="reveal scale-in">
      <span class="type-massive" style="font-size: clamp(40px, 10vw, 140px); display: block;">Your seat</span>
      <span class="type-massive" style="font-size: clamp(40px, 10vw, 140px); display: block;">is <span style="color: #D4A843;">ready.</span></span>
    </div>
    <div style="margin-top: 64px; display: flex; flex-wrap: wrap; justify-content: center; gap: 32px 64px;">
      <a href={`${base}conference/register/`} class="cta-text reveal" style="font-size: clamp(32px, 6vw, 72px); color: #c84342;">Join Our Community</a>
      <div style="flex-basis: 100%; height: 0;"></div>
      <a href={`${base}conference/cfp/`} class="cta-text reveal" style="font-size: clamp(32px, 6vw, 72px); color: #D4A843;">Speak</a>
    </div>
    <div class="line-divider" style="color: #fff; margin: 80px 0 48px;"></div>

    <div class="reveal" style="margin-bottom: 64px;">
      <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: rgba(255,255,255,0.4); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px;">Join 2,500+ in our community</p>
      <CommunitySignup layout="compact" buttonText="Subscribe" />
    </div>

    <footer class="reveal footer-zone">
      <div class="footer-nav" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: left; max-width: 700px; margin: 0 auto 48px;">
        <div>
          <p style="font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.25); margin-bottom: 12px; font-family: 'Space Grotesk', sans-serif; font-weight: 600;">About</p>
          <a href={`${base}about/`} style="display: block; margin-bottom: 8px;">Overview</a>
          <a href={`${base}about/mission/`} style="display: block; margin-bottom: 8px;">Mission</a>
          <a href={`${base}about/programs/`} style="display: block; margin-bottom: 8px;">Programs</a>
          <a href={`${base}about/board/`} style="display: block; margin-bottom: 8px;">Board</a>
        </div>
        <div>
          <p style="font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.25); margin-bottom: 12px; font-family: 'Space Grotesk', sans-serif; font-weight: 600;">Conference</p>
          <a href={`${base}conference/`} style="display: block; margin-bottom: 8px;">Overview</a>
          <a href={`${base}conference/speakers/`} style="display: block; margin-bottom: 8px;">Speakers</a>
          <a href={`${base}conference/schedule/`} style="display: block; margin-bottom: 8px;">Schedule</a>
          <!-- Sponsor link removed -->
          <a href={`${base}conference/cfp/`} style="display: block; margin-bottom: 8px;">Call for Papers</a>
        </div>
        <div>
          <p style="font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.25); margin-bottom: 12px; font-family: 'Space Grotesk', sans-serif; font-weight: 600;">Resources</p>
          <a href={`${base}juneteenth/`} style="display: block; margin-bottom: 8px;">Juneteenth</a>
          <a href={`${base}coc/`} style="display: block; margin-bottom: 8px;">Code of Conduct</a>
          <a href={`${base}past-events/`} style="display: block; margin-bottom: 8px;">Past Events</a>
          <a href={`${base}contact/`} style="display: block; margin-bottom: 8px;">Contact</a>
        </div>
      </div>

      <div style="text-align: center;">
        <p style="margin-bottom: 24px;"><strong style="color: rgba(255,255,255,0.8);">June 19&ndash;20, 2026</strong> &bull; Chicago, IL</p>
        <p style="margin-bottom: 8px;">JuneteenthConf, Unl. &mdash; Fiscally sponsored by YPOC Harrisburg (501(c)(3))</p>
        <p style="margin-bottom: 24px;"><a href="mailto:info@juneteenthconf.com">info@juneteenthconf.com</a></p>
        <div style="display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-bottom: 32px;">
          <a href="https://twitter.com/juneteenthconf">Twitter</a>
          <a href="https://linkedin.com/company/juneteenthconf">LinkedIn</a>
          <a href="https://youtube.com/@juneteenthconf">YouTube</a>
          <a href="https://instagram.com/juneteenthconf">Instagram</a>
        </div>
        <p style="font-size: 12px; color: rgba(255,255,255,0.2);">Artwork by Havana Nguyen &bull; &copy; 2020&ndash;2026 JuneteenthConf</p>
        <p style="font-size: 10px; color: rgba(255,255,255,0.12); margin-top: 8px;">Historical images: Wikimedia Commons / Library of Congress. All public domain.</p>
      </div>
    </footer>
  </div>
</section>

<div style="height: 36px;"></div>

---
---

<section class="scene scene-denied" id="denied" style="flex-direction: column;">
  <div class="legend-card right" style="top: 30%;">
    <div class="legend-portrait legend-portrait-archival">
      <img src="/images/latimer.webp" alt="Lewis Howard Latimer" width="80" height="80" loading="lazy" />
    </div>
    <div class="legend-info">
      <div class="legend-name">Lewis Howard Latimer</div>
      <div class="legend-years">1848 &ndash; 1928</div>
      <div class="legend-desc">Improved the lightbulb. Drafted patents for Alexander Graham Bell. Denied credit for generations.</div>
    </div>
  </div>

  <div style="max-width: 800px; width: 100%; position: relative; z-index: 1;">
    <figure class="scene-image img-archival img-fade-edges reveal scale-in ken-burns-pan" style="margin-bottom: 48px;">
      <img src="/images/colored-fountain-800.webp"
           srcset="/images/colored-fountain-400.webp 400w, /images/colored-fountain-500.webp 500w, /images/colored-fountain-800.webp 800w"
           sizes="(max-width: 540px) 100vw, (max-width: 900px) 500px, 800px"
           alt="A man drinking from a segregated 'Colored' water fountain"
           width="800" height="549"
           loading="lazy" style="max-height: 55vh; object-fit: cover; width: 100%;" />
      <figcaption>"Colored" drinking fountain, mid-20th century. Public domain.</figcaption>
    </figure>

    <div class="reveal-stagger" style="display: flex; flex-direction: column; gap: 48px;">
      <div class="reveal from-left">
        <p class="font-display" style="font-size: clamp(14px, 2vw, 18px); letter-spacing: 4px; text-transform: uppercase; opacity: 0.3; margin-bottom: 12px;">1787</p>
        <p class="font-body" style="font-size: 16px; line-height: 1.8; opacity: 0.5;">Three-Fifths of a person. Counted for representation, excluded from it.</p>
      </div>
      <div class="reveal from-right">
        <p class="font-display" style="font-size: clamp(14px, 2vw, 18px); letter-spacing: 4px; text-transform: uppercase; opacity: 0.3; margin-bottom: 12px;">1857</p>
        <p class="font-body" style="font-size: 16px; line-height: 1.8; opacity: 0.5;">&ldquo;No rights which the white man was bound to respect.&rdquo; &mdash; Dred Scott v. Sandford</p>
      </div>
      <div class="reveal from-left">
        <p class="font-display" style="font-size: clamp(14px, 2vw, 18px); letter-spacing: 4px; text-transform: uppercase; opacity: 0.3; margin-bottom: 12px;">1896</p>
        <p class="font-body" style="font-size: 16px; line-height: 1.8; opacity: 0.5;">Separate but equal. Different tables entirely.</p>
      </div>
    </div>

    <div class="chain-break reveal" style="margin: 56px 0;">
      <div class="chain-link"></div><div class="chain-link"></div><div class="chain-link"></div><div class="chain-link"></div><div class="chain-link"></div>
    </div>

    <p class="reveal font-display" style="font-size: clamp(20px, 3.5vw, 36px); font-weight: 300; line-height: 1.5; text-align: center; opacity: 0.7;">
      Centuries of being told:<br />
      <span style="color: rgba(200, 67, 66, 0.7); font-weight: 600;">&ldquo;This table is not for you.&rdquo;</span>
    </p>
  </div>
</section>

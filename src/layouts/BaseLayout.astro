---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Juneteenth Conference 2026 — Building Our Own Table',
  description = 'Juneteenth Conference returns to Chicago, June 19-20, 2026. Two days of curated sessions across engineering, data, security, entrepreneurship, and tech leadership. Building Our Own Table.',
} = Astro.props;

const b = import.meta.env.BASE_URL;
const base = b.endsWith('/') ? b : b + '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@juneteenthconf" />

  <!-- Favicon placeholder -->
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

  <!-- Preload fonts -->
  <link rel="preload" href={`${base}fonts/space-grotesk-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a href="#main-content" class="skip-nav">Skip to main content</a>

  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

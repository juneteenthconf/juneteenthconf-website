---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
---

<InteriorLayout
  title="Call for Papers — Juneteenth Conference 2026"
  description="The Call for Papers for Juneteenth Conference 2026 is now closed. Schedule information coming soon."
  current="Conference"
  heroTitle="Call for Papers"
  heroSubtitle="June 19–20, 2026 &bull; Chicago, IL"
  heroAccent="red"
>
  <section class="interior-section">
    <div class="interior-content">
      <div class="reveal-stagger">

        <div class="reveal closed-block">
          <span class="closed-badge">Submissions Closed</span>
          <h2 class="closed-title">The Call for Papers is now closed.</h2>
          <p class="closed-text">
            Thank you to everyone who submitted a proposal. We received an incredible response and are grateful for the talent and energy this community brings. Speakers will be notified directly.
          </p>
          <p class="closed-text">
            Schedule information will be updated soon. <a href="/conference/register/" class="closed-link">Register now</a> to be there when we announce.
          </p>
        </div>

        <div class="reveal info-grid">
          <div class="info-card">
            <span class="info-label">Conference</span>
            <span class="info-value">June 19–20, 2026</span>
          </div>
          <div class="info-card">
            <span class="info-label">Venue</span>
            <span class="info-value">Microsoft Chicago</span>
          </div>
          <div class="info-card">
            <span class="info-label">Day 1</span>
            <span class="info-value">Conference Sessions</span>
          </div>
          <div class="info-card">
            <span class="info-label">Day 2</span>
            <span class="info-value">AI Workshop &amp; Hackathon</span>
          </div>
        </div>

        <div class="reveal cta-block">
          <a href="/conference/" class="cta-outline">Back to Conference</a>
          <a href="/conference/register/" class="cta-primary">Register</a>
        </div>

      </div>
    </div>
  </section>
</InteriorLayout>

<style>
  .interior-section {
    padding: 60px 24px 100px;
    background: #231c2d;
  }
  .interior-content {
    max-width: 760px; margin: 0 auto;
  }

  .closed-block {
    text-align: center;
    margin-bottom: 56px;
    padding: 56px 40px;
    background: rgba(45, 36, 56, 0.3);
    border: 1px solid rgba(240, 237, 230, 0.06);
    border-radius: 12px;
  }
  .closed-badge {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600; font-size: 12px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: #c84342; border: 1px solid rgba(200, 67, 66, 0.3);
    padding: 6px 16px; border-radius: 100px;
    margin-bottom: 24px;
  }
  .closed-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: clamp(22px, 4vw, 32px);
    color: #f0ede6; margin-bottom: 20px;
  }
  .closed-text {
    font-family: 'Inter', sans-serif;
    font-size: 17px; color: rgba(240, 237, 230, 0.6);
    line-height: 1.8; margin-bottom: 16px;
    max-width: 560px; margin-left: auto; margin-right: auto;
  }
  .closed-link {
    color: #D4A843; text-decoration: none;
    font-weight: 500;
  }
  .closed-link:hover { text-decoration: underline; }

  .info-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 12px; margin-bottom: 48px;
  }
  .info-card {
    background: rgba(45, 36, 56, 0.5);
    border: 1px solid rgba(200, 67, 66, 0.2);
    border-radius: 8px; padding: 20px 16px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .info-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px; color: rgba(240, 237, 230, 0.35);
    text-transform: uppercase; letter-spacing: 0.12em;
  }
  .info-value {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600; font-size: 15px; color: #f0ede6;
  }

  .cta-block {
    display: flex; gap: 16px; flex-wrap: wrap; justify-content: center;
  }

  @media (max-width: 640px) {
    .info-grid { grid-template-columns: 1fr 1fr; }
    .closed-block { padding: 40px 24px; }
  }
</style>

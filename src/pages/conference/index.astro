---
import { Image } from 'astro:assets';
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import recapHassan from '../../assets/images/recap-hassan.png';
import recapGroup from '../../assets/images/recap-group.jpg';
import recapSelfie from '../../assets/images/recap-selfie.jpg';
import recapMadison from '../../assets/images/recap-madison.png';
import backdrop from '../../assets/images/speakers-chicago-backdrop.png';

const b = import.meta.env.BASE_URL;
const base = b.endsWith('/') ? b : b + '/';
---

<InteriorLayout
  ogSlug="conference"
  title="Conference — Juneteenth Conference 2026"
  description="Juneteenth Conference 2026 returns to Chicago, June 19-20. Day 1: 6 curated sessions with keynote by Madison Butler. Day 2: AI Assisted Coding Workshop + hackathon."
  current="Conference"
  heroTitle="The Conference"
  heroSubtitle="June 19-20, 2026 &bull; Chicago, IL"
  heroAccent="gold"
>
  <section class="interior-section">
    <div class="interior-content">
      <div class="reveal-stagger">
        <p class="reveal section-lede">
          <strong style="color: #D4A843;">Building Our Own Table.</strong> Thank you to everyone who joined us in Chicago! Our speakers delivered in spades, offering profound insights, actionable advice, and the inspiration needed to navigate today’s professional landscape.
        </p>

        <div class="reveal recap-grid">
          <div class="recap-card">
            <h3 class="recap-name">Pierre Debois</h3>
            <p class="recap-desc">Reprised his powerful "Owning our History" talk from 2021, brilliantly updating it to address the new frontiers and challenges of AI.</p>
          </div>
          <div class="recap-card">
            <h3 class="recap-name">Ashley Janelle</h3>
            <p class="recap-desc">Shared her inspiring founder journey, discussing the reality and power of building your own table when no one else is hiring.</p>
          </div>
          <div class="recap-card">
            <h3 class="recap-name">Hassan Shahid</h3>
            <p class="recap-desc">Shared his tech journey with "No CS Degree, No Permission, No Problem," discussing how he navigated a tech career from network support to an engineer at Meta.</p>
          </div>
          <div class="recap-card">
            <h3 class="recap-name">Clarene Mitchell</h3>
            <p class="recap-desc">Came through with practical, high-impact strategies on how to leverage LinkedIn to support and grow your business.</p>
          </div>
          <div class="recap-card">
            <h3 class="recap-name">Ramatu Kandakai</h3>
            <p class="recap-desc">Spoke passionately about the importance of staying true to yourself and not compromising your identity just for a "seat at the table."</p>
          </div>
          <div class="recap-card">
            <h3 class="recap-name">Madison Butler</h3>
            <p class="recap-desc">Closed out the day sitting down with our Executive Director for a candid, unforgettable interview about identity, resilience, and self-care in corporate America.</p>
          </div>
        </div>

        <h2 class="reveal section-heading" style="color: #55ac64; margin-top: 64px;">Event Highlights</h2>
        <div class="reveal highlights-grid">
          <div class="highlight-wrap">
            <Image src={recapHassan} alt="Hassan delivers his talk" class="highlight-image" style="object-position: top center;" loading="lazy" />
            <div class="highlight-caption">Hassan delivers his talk</div>
          </div>
          <div class="highlight-wrap">
            <Image src={recapGroup} alt="Black Girl Magic at Juneteenth Conference" class="highlight-image" loading="lazy" />
            <div class="highlight-caption">Black Girl Magic at Juneteenth Conference</div>
          </div>
          <div class="highlight-wrap">
            <Image src={recapSelfie} alt="Some of our board members take a selfie" class="highlight-image" loading="lazy" />
            <div class="highlight-caption">Some of our board members take a selfie</div>
          </div>
          
          <div class="highlight-wrap" style="background: rgba(45, 36, 56, 0.5); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; border: 1px solid rgba(212, 168, 67, 0.1);">
            <h3 style="color: #D4A843; font-family: 'Space Grotesk', sans-serif; font-size: 22px; margin-bottom: 16px;">Don't miss 2027</h3>
            <a href={`${base}conference/register/`} class="cta-outline cta-speak" style="font-size: 14px; padding: 10px 20px; text-decoration: none;">Join Our Community</a>
          </div>

          <div class="highlight-wrap highlight-full">
            <Image src={recapMadison} alt="Fireside Chat with Madison and Michael" class="highlight-image" loading="lazy" />
            <div class="highlight-caption">Fireside Chat with Madison and Michael</div>
          </div>
          <div class="highlight-wrap highlight-full">
            <Image src={backdrop} alt="Michael joins our speakers" class="highlight-image" loading="lazy" />
            <div class="highlight-caption">Michael joins our speakers</div>
          </div>
        </div>

        <div class="reveal cta-block">
          <a href={`${base}conference/register/`} class="cta-primary">Join Our Community</a>
        </div>
      </div>
    </div>
  </section>
</InteriorLayout>

<style>
  .interior-section {
    padding: 60px 24px 80px;
    background: #231c2d;
  }
  .interior-content {
    max-width: 800px; margin: 0 auto;
  }
  .section-lede {
    font-family: 'Inter', sans-serif;
    font-size: clamp(17px, 2vw, 21px);
    color: rgba(240, 237, 230, 0.7);
    line-height: 1.8; margin-bottom: 48px;
  }
  .recap-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px; margin-bottom: 56px;
  }
  .recap-card {
    background: rgba(45, 36, 56, 0.5);
    border: 1px solid rgba(212, 168, 67, 0.1);
    border-radius: 8px; padding: 24px;
  }
  .recap-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 20px; color: #D4A843;
    margin-bottom: 12px;
  }
  .recap-desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px; color: rgba(240, 237, 230, 0.7);
    line-height: 1.6;
  }
  .section-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 28px;
    text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: 32px;
  }
  .highlights-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 16px; margin-bottom: 56px;
  }
  .highlight-wrap {
    border-radius: 8px; overflow: hidden;
    aspect-ratio: 4/3;
    position: relative;
  }
  .highlight-image {
    width: 100%; height: 100%; object-fit: cover;
    display: block; transition: transform 0.3s ease;
  }
  .highlight-wrap:hover .highlight-image {
    transform: scale(1.05);
  }
  .highlight-caption {
    position: absolute; bottom: 0; left: 0; right: 0;
    color: #f0ede6; font-family: 'Inter', sans-serif;
    font-size: 15px; padding: 16px;
    background: transparent;
    text-shadow: 0px 2px 4px rgba(0,0,0,0.8);
    pointer-events: none;
    z-index: 2;
  }
  .highlight-full {
    grid-column: 1 / -1;
    aspect-ratio: auto; /* Let the image dictate the height to prevent cropping */
  }
  .highlight-full .highlight-image {
    height: auto;
  }
  .fix-washout {
    /* The original file is inherently desaturated, so we can use CSS filters to restore the contrast and color punch */
    filter: contrast(1.25) saturate(1.3);
  }
  .cta-block {
    display: flex; gap: 20px; flex-wrap: wrap;
    justify-content: center; padding-top: 16px;
  }
  .cta-speak { border-color: rgba(212, 168, 67, 0.4); color: #D4A843; }
  .cta-speak:hover { border-color: #D4A843; color: #f0ede6; }

  @media (max-width: 640px) {
    .highlights-grid { grid-template-columns: 1fr; }
  }
</style>

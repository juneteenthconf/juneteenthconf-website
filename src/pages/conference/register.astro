        fontSmoothing: 'antialiased',
        '::placeholder': { color: 'rgba(240, 237, 230, 0.25)' },
        iconColor: 'rgba(240, 237, 230, 0.4)',
      },
      invalid: { color: '#c84342', iconColor: '#c84342' },
    },
  });

  cardElement.mount('#card-element');

  const cardContainer = document.getElementById('card-element') as HTMLElement;
  const cardErrors = document.getElementById('card-errors') as HTMLElement;

  let cardComplete = false;

  cardElement.on('focus', () => cardContainer.classList.add('focused'));
  cardElement.on('blur', () => cardContainer.classList.remove('focused'));
  cardElement.on('change', (e: any) => {
    cardErrors.textContent = e.error ? e.error.message : '';
    cardComplete = e.complete;
  });

  // Pricing state
  const isSale = new Date() < SALE_ENDS;
  let basePrice = isSale ? 50 : 75;
  let studentPromoApplied = false;
  let appliedPromoCode = '';

  // Show sale note if active
  const saleNote = document.getElementById('sale-note') as HTMLElement;
  const ticketPriceDisplay = document.getElementById('ticket-price-display') as HTMLElement;
  if (isSale) {
    saleNote.style.display = 'block';
    ticketPriceDisplay.textContent = '$50';
  }

  function updateTotal() {
    const total = basePrice + (scholarshipQty * 75) + Math.max(0, Math.floor(contribution));
    document.getElementById('total-display')!.textContent = `$${total}`;
    document.getElementById('btn-total')!.textContent = `$${total}`;
  }

  // Scholarship + contribution logic
  let contribution = 0;
  let scholarshipQty = 0;
  const customInput = document.getElementById('custom-amount') as HTMLInputElement;
  const scholarshipQtyEl = document.getElementById('scholarship-qty') as HTMLElement;
  const minusBtn = document.getElementById('scholarship-minus') as HTMLButtonElement;
  const plusBtn = document.getElementById('scholarship-plus') as HTMLButtonElement;

  minusBtn.addEventListener('click', () => {
    if (scholarshipQty > 0) {
      scholarshipQty--;
      scholarshipQtyEl.textContent = String(scholarshipQty);
      minusBtn.disabled = scholarshipQty === 0;
      updateTotal();
    }
  });
  minusBtn.disabled = true;

  plusBtn.addEventListener('click', () => {
    scholarshipQty++;
    scholarshipQtyEl.textContent = String(scholarshipQty);
    minusBtn.disabled = false;
    updateTotal();
  });

  document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      contribution = parseInt(btn.dataset.amount || '0');
      customInput.value = contribution > 0 ? String(contribution) : '';
      updateTotal();
    });
  });

  customInput.addEventListener('input', () => {
    const val = parseFloat(customInput.value) || 0;
    contribution = val;
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    const match = document.querySelector<HTMLButtonElement>(`.preset-btn[data-amount="${Math.floor(val)}"]`);
    if (match && val === Math.floor(val)) match.classList.add('active');
    updateTotal();
  });

  // Promo code logic
  const promoInput = document.getElementById('promo-input') as HTMLInputElement;
  const promoApplyBtn = document.getElementById('promo-apply-btn') as HTMLButtonElement;
  const promoMessage = document.getElementById('promo-message') as HTMLElement;
  const studentBadge = document.getElementById('student-badge') as HTMLElement;
  const eduRequired = document.getElementById('edu-required') as HTMLElement;

  function applyPromo() {
    const code = promoInput.value.trim().toUpperCase();
    promoMessage.className = 'promo-message';
    promoMessage.style.display = 'none';

    if (code === STUDENT_CODE) {
      basePrice = 25;
      studentPromoApplied = true;
      appliedPromoCode = code;
      ticketPriceDisplay.textContent = '$25';
      studentBadge.style.display = 'block';
      saleNote.style.display = 'none';
      eduRequired.style.display = 'inline';
      promoMessage.textContent = 'Student rate applied — $25. Your email must end in .edu.';
      promoMessage.classList.add('success');
      promoMessage.style.display = 'block';
      promoInput.disabled = true;
      promoApplyBtn.disabled = true;
    } else if (code === '') {
      promoMessage.textContent = 'Enter a promo code.';
      promoMessage.classList.add('error');
      promoMessage.style.display = 'block';
    } else {
      promoMessage.textContent = 'That code isn\'t valid.';
      promoMessage.classList.add('error');
      promoMessage.style.display = 'block';
    }

    updateTotal();
  }

  promoApplyBtn.addEventListener('click', applyPromo);
  promoInput.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') { e.preventDefault(); applyPromo(); }
  });

  // Form submission
  const form = document.getElementById('register-form') as HTMLFormElement;
  const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
  const errorMsg = document.getElementById('reg-error-msg') as HTMLElement;
  const successBlock = document.getElementById('reg-success') as HTMLElement;
  const paymentErrorBanner = document.getElementById('payment-error-banner') as HTMLElement;
  const soldOutBanner = document.getElementById('sold-out-banner') as HTMLElement;

  document.querySelectorAll<HTMLElement>('.field-input, .field-select').forEach(el => {
    el.addEventListener('input', () => el.classList.remove('field-error'));
    el.addEventListener('change', () => el.classList.remove('field-error'));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nameEl = document.getElementById('reg-name') as HTMLInputElement;
    const emailEl = document.getElementById('reg-email') as HTMLInputElement;
    const sizeEl = document.getElementById('tshirt-size') as HTMLSelectElement;

    let valid = true;
    [nameEl, emailEl, sizeEl].forEach(el => {
      if (!el.value.trim()) { el.classList.add('field-error'); valid = false; }
    });

    // Card element must be complete before hitting the API
    if (!cardComplete) {
      cardErrors.textContent = 'Please enter your card details.';
      cardContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    // .edu validation for student promo
    if (studentPromoApplied && !emailEl.value.trim().toLowerCase().endsWith('.edu')) {
      emailEl.classList.add('field-error');
      promoMessage.textContent = 'Student rate requires a .edu email address.';
      promoMessage.className = 'promo-message error';
      promoMessage.style.display = 'block';
      valid = false;
    }

    if (!valid) {
      errorMsg.style.display = 'block';
      form.querySelector<HTMLElement>('.field-error')?.focus();
      return;
    }
    errorMsg.style.display = 'none';

    payBtn.disabled = true;
    payBtn.textContent = 'Processing…';
    paymentErrorBanner.style.display = 'none';
    soldOutBanner.style.display = 'none';

    try {
      const total = basePrice + (scholarshipQty * 75) + Math.max(0, Math.floor(contribution));

      const res = await fetch('/api/create-payment-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: total,
          name: nameEl.value.trim(),
          email: emailEl.value.trim(),
          tshirtSize: sizeEl.value,
          scholarshipTickets: scholarshipQty,
          contribution: Math.max(0, Math.floor(contribution)),
          promoCode: appliedPromoCode,
        }),
      });

      const data = await res.json();

      if (data.error === 'SOLD_OUT') {
        form.style.display = 'none';
        soldOutBanner.style.display = 'block';
        soldOutBanner.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      if (data.error) throw new Error(data.error);

      const { error: stripeError } = await stripe.confirmCardPayment(data.clientSecret, {
        payment_method: {
          card: cardElement,
          billing_details: {
            name: nameEl.value.trim(),
            email: emailEl.value.trim(),
          },
        },
      });

      if (stripeError) throw new Error(stripeError.message);

      (document.getElementById('success-email') as HTMLElement).textContent = emailEl.value.trim();
      form.style.display = 'none';
      successBlock.style.display = 'block';
      successBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });

    } catch (err: any) {
      payBtn.disabled = false;
      payBtn.innerHTML = `Pay <span id="btn-total">$${basePrice + (scholarshipQty * 75) + Math.max(0, Math.floor(contribution))}</span>`;
      paymentErrorBanner.style.display = 'block';
      if (err.message) cardErrors.textContent = err.message;
    }
  });

  // Initialize total display
  updateTotal();
</script>

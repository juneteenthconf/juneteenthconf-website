---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
---

<InteriorLayout
  title="Register — Juneteenth Conference 2026"
  description="Registration for Juneteenth Conference 2026. Sign up to be notified when registration opens."
  current="Conference"
  heroTitle="Register"
  heroSubtitle="June 19&ndash;20, 2026 &bull; Chicago, IL"
  heroAccent="red"
>
  <section class="interior-section">
    <div class="interior-content">
      <div class="reveal-stagger">
        <div class="reveal coming-soon-block">
          <span class="coming-soon-badge">Coming Soon</span>
          <h2 class="coming-soon-title">Registration opening soon.</h2>
          <p class="coming-soon-text">
            We're finalizing the details for Juneteenth Conference 2026. Sign up below and we'll notify you the moment registration opens.
          </p>
        </div>

        <div class="reveal signup-block">
          <h3 class="signup-heading">Get Notified</h3>
          <form action="https://juneteenthconf.us10.list-manage.com/subscribe/post?u=07ef187a16bc5cd4f2375c824&id=4d06862da4" method="post" class="signup-form" aria-label="Registration notification signup">
            <label for="register-email" class="sr-only">Email address</label>
            <input type="email" name="EMAIL" id="register-email" class="newsletter-input" placeholder="your@email.com" required />
            <button type="submit" class="newsletter-btn">Notify Me</button>
          </form>
          <p class="signup-note">Join 2,500+ subscribers. No spam, just conference updates.</p>
        </div>

        <div class="reveal details-grid">
          <div class="detail-card">
            <span class="detail-label">Dates</span>
            <span class="detail-value">June 19&ndash;20, 2026</span>
          </div>
          <div class="detail-card">
            <span class="detail-label">Location</span>
            <span class="detail-value">Chicago, IL</span>
          </div>
          <div class="detail-card">
            <span class="detail-label">Format</span>
            <span class="detail-value">In-person</span>
          </div>
          <div class="detail-card">
            <span class="detail-label">Sessions</span>
            <span class="detail-value">20 curated talks</span>
          </div>
        </div>

        <div class="reveal cta-block">
          <p class="cta-prompt">Questions about registration?</p>
          <a href="mailto:info@juneteenthconf.com" class="cta-outline">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</InteriorLayout>

<style>
  .interior-section {
    padding: 60px 24px 80px;
    background: #231c2d;
  }
  .interior-content {
    max-width: 700px; margin: 0 auto;
  }
  .coming-soon-block {
    text-align: center; margin-bottom: 48px;
  }
  .coming-soon-badge {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600; font-size: 12px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: #c84342; border: 1px solid rgba(200, 67, 66, 0.3);
    padding: 6px 16px; border-radius: 100px;
    margin-bottom: 24px;
  }
  .coming-soon-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: clamp(22px, 4vw, 32px);
    color: #f0ede6; margin-bottom: 16px;
  }
  .coming-soon-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px; color: rgba(240, 237, 230, 0.55);
    line-height: 1.7;
  }
  .signup-block {
    text-align: center; margin-bottom: 56px;
    background: rgba(45, 36, 56, 0.4);
    border: 1px solid rgba(212, 168, 67, 0.1);
    border-radius: 8px; padding: 40px 32px;
  }
  .signup-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 22px;
    color: #D4A843; margin-bottom: 24px;
  }
  .signup-form {
    display: flex; flex-wrap: wrap;
    justify-content: center; gap: 12px;
    margin-bottom: 16px;
  }
  .signup-note {
    font-family: 'Inter', sans-serif;
    font-size: 13px; color: rgba(255,255,255,0.3);
    margin-top: 12px;
  }
  .details-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 16px; margin-bottom: 48px;
  }
  .detail-card {
    background: rgba(45, 36, 56, 0.5);
    border: 1px solid rgba(212, 168, 67, 0.1);
    border-radius: 8px; padding: 24px;
  }
  .detail-label {
    font-family: 'Inter', sans-serif;
    font-size: 12px; color: rgba(255,255,255,0.4);
    letter-spacing: 0.15em; text-transform: uppercase;
    display: block; margin-bottom: 8px;
  }
  .detail-value {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 20px; color: #f0ede6;
  }
  .cta-block {
    text-align: center; padding-top: 16px;
  }
  .cta-prompt {
    font-family: 'Inter', sans-serif;
    font-size: 14px; color: rgba(255,255,255,0.4);
    margin-bottom: 16px;
  }

  @media (max-width: 640px) {
    .details-grid { grid-template-columns: 1fr; }
    .signup-block { padding: 32px 20px; }
  }
</style>

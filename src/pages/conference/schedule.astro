---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
---

<InteriorLayout
  title="Schedule — Juneteenth Conference 2026"
  description="Schedule for Juneteenth Conference 2026. Two days, 20 sessions across engineering, data, security, entrepreneurship, and tech leadership."
  current="Schedule"
  heroTitle="Schedule"
  heroSubtitle="Two days &bull; 20 sessions"
  heroAccent="red"
>
  <section class="interior-section">
    <div class="interior-content">
      <div class="reveal-stagger">
        <div class="reveal coming-soon-block">
          <span class="coming-soon-badge">Coming Soon</span>
          <h2 class="coming-soon-title">Schedule details are being finalized.</h2>
          <p class="coming-soon-text">
            We're curating 20 sessions across two days spanning engineering, data, security, entrepreneurship, and tech leadership. The full schedule will be announced as we get closer to the event.
          </p>
        </div>

        <div class="reveal day-preview">
          <div class="day-card">
            <span class="day-label">Day 1</span>
            <span class="day-date">Thursday, June 19</span>
            <p class="day-desc">Opening keynote by Madison Butler, technical sessions, and panels.</p>
          </div>
          <div class="day-card">
            <span class="day-label">Day 2</span>
            <span class="day-date">Friday, June 20</span>
            <p class="day-desc">Deep-dive workshops, lightning talks, and closing sessions.</p>
          </div>
        </div>

        <div class="reveal topics-block">
          <h3 class="topics-heading">Session Tracks</h3>
          <div class="topics-grid">
            <span class="topic-tag">Engineering</span>
            <span class="topic-tag">Data Science</span>
            <span class="topic-tag">Security</span>
            <span class="topic-tag">AI &amp; ML</span>
            <span class="topic-tag">Entrepreneurship</span>
            <span class="topic-tag">Tech Leadership</span>
            <span class="topic-tag">Career Growth</span>
            <span class="topic-tag">Cloud &amp; Infrastructure</span>
          </div>
        </div>

        <div class="reveal newsletter-block">
          <p class="newsletter-prompt">Get notified when the schedule drops.</p>
          <form action="https://juneteenthconf.us10.list-manage.com/subscribe/post?u=07ef187a16bc5cd4f2375c824&id=4d06862da4" method="post" class="newsletter-form" aria-label="Newsletter signup">
            <label for="schedule-email" class="sr-only">Email address</label>
            <input type="email" name="EMAIL" id="schedule-email" class="newsletter-input" placeholder="your@email.com" required />
            <button type="submit" class="newsletter-btn">Notify Me</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</InteriorLayout>

<style>
  .interior-section {
    padding: 60px 24px 80px;
    background: #231c2d;
  }
  .interior-content {
    max-width: 700px; margin: 0 auto;
  }
  .coming-soon-block {
    text-align: center; margin-bottom: 56px;
  }
  .coming-soon-badge {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600; font-size: 12px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: #c84342; border: 1px solid rgba(200, 67, 66, 0.3);
    padding: 6px 16px; border-radius: 100px;
    margin-bottom: 24px;
  }
  .coming-soon-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: clamp(22px, 4vw, 32px);
    color: #f0ede6; margin-bottom: 16px;
  }
  .coming-soon-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px; color: rgba(240, 237, 230, 0.55);
    line-height: 1.7;
  }
  .day-preview {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 20px; margin-bottom: 56px;
  }
  .day-card {
    background: rgba(45, 36, 56, 0.4);
    border: 1px solid rgba(212, 168, 67, 0.1);
    border-radius: 8px; padding: 28px;
  }
  .day-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 14px;
    color: #D4A843; text-transform: uppercase;
    letter-spacing: 0.1em; display: block; margin-bottom: 8px;
  }
  .day-date {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600; font-size: 18px;
    color: #f0ede6; display: block; margin-bottom: 12px;
  }
  .day-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px; color: rgba(240, 237, 230, 0.5);
    line-height: 1.6;
  }
  .topics-block {
    margin-bottom: 56px;
  }
  .topics-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600; font-size: 18px;
    color: rgba(240, 237, 230, 0.6);
    text-transform: uppercase; letter-spacing: 0.1em;
    margin-bottom: 20px;
  }
  .topics-grid {
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .topic-tag {
    font-family: 'Inter', sans-serif;
    font-size: 13px; color: rgba(240, 237, 230, 0.5);
    border: 1px solid rgba(240, 237, 230, 0.15);
    padding: 8px 16px; border-radius: 100px;
  }
  .newsletter-block {
    text-align: center; padding-top: 16px;
  }
  .newsletter-prompt {
    font-family: 'Inter', sans-serif;
    font-size: 14px; color: rgba(255,255,255,0.4);
    letter-spacing: 0.1em; text-transform: uppercase;
    margin-bottom: 20px;
  }
  .newsletter-form {
    display: flex; flex-wrap: wrap;
    justify-content: center; gap: 12px;
  }

  @media (max-width: 640px) {
    .day-preview { grid-template-columns: 1fr; }
  }
</style>

---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
---

<InteriorLayout
  ogSlug="sponsor"
  title="Sponsor — Juneteenth Conference 2026"
  description="Become a sponsor of Juneteenth Conference 2026. Packages from $500 to $50,000. Support Black excellence in tech."
  current="Sponsor"
  heroTitle="Sponsor"
  heroSubtitle="Invest in Black excellence in tech"
  heroAccent="gold"
>
  <section class="interior-section">
    <div class="interior-content">
      <div class="reveal-stagger">

        <p class="reveal section-lede">
          Your sponsorship helps produce a world-class conference and funds year-round programs
          addressing the Digital Divide through mentorship, scholarship, and professional readiness
          for Black professionals in tech.
        </p>

        <p class="reveal donation-note">
          Approximately 60% of your sponsorship is a tax-deductible charitable donation through our
          fiscal sponsor, YPOC Harrisburg (501(c)(3)). The remaining 40% covers direct sponsor benefits.
        </p>

        <!-- Featured tiers -->
        <div class="reveal featured-grid">
          <div class="tier-card tier-presented">
            <span class="tier-badge">Presented By</span>
            <span class="tier-price">$50,000</span>
            <ul class="tier-perks">
              <li>"Presented By" naming on all conference branding</li>
              <li>Logo on all conference materials &amp; website</li>
              <li>Premium booth in central hall</li>
              <li>90-second video during session transitions</li>
              <li>10-minute opening address</li>
              <li>VIP + general networking access</li>
              <li>10 full-access tickets</li>
              <li>Social media spotlight</li>
              <li>Newsletter feature</li>
              <li>2027 first right of refusal</li>
            </ul>
            <a href="mailto:info@juneteenthconf.com?subject=Presented%20By%20Sponsorship" class="tier-cta">Get in Touch</a>
          </div>

          <div class="tier-card tier-title">
            <span class="tier-badge">Title</span>
            <span class="tier-price">$25,000</span>
            <ul class="tier-perks">
              <li>Logo on all conference materials &amp; website</li>
              <li>Premium booth in central hall</li>
              <li>60-second video during session transitions</li>
              <li>5-minute opening address</li>
              <li>VIP + general networking access</li>
              <li>8 full-access tickets</li>
              <li>Social media spotlight</li>
              <li>Newsletter feature</li>
              <li>2027 first right of refusal</li>
            </ul>
            <a href="mailto:info@juneteenthconf.com?subject=Title%20Sponsorship" class="tier-cta">Get in Touch</a>
          </div>

          <div class="tier-card tier-signature">
            <span class="tier-badge">Signature</span>
            <span class="tier-price">$12,500</span>
            <ul class="tier-perks">
              <li>Logo on all conference materials &amp; website</li>
              <li>Booth in central hall</li>
              <li>60-second video during session transitions</li>
              <li>General networking access</li>
              <li>6 full-access tickets</li>
              <li>Social media spotlight</li>
              <li>Newsletter feature</li>
            </ul>
            <a href="mailto:info@juneteenthconf.com?subject=Signature%20Sponsorship" class="tier-cta">Get in Touch</a>
          </div>
        </div>

        <!-- Supporting tiers -->
        <div class="reveal supporting-grid">
          <div class="tier-card tier-community">
            <span class="tier-badge">Community</span>
            <span class="tier-price">$5,000</span>
            <ul class="tier-perks">
              <li>Logo on conference materials &amp; website</li>
              <li>Booth in central hall</li>
              <li>General networking access</li>
              <li>4 full-access tickets</li>
              <li>Social media spotlight</li>
            </ul>
          </div>

          <div class="tier-card tier-stage">
            <span class="tier-badge">Stage</span>
            <span class="tier-price">$2,500</span>
            <ul class="tier-perks">
              <li>Logo on conference materials &amp; website</li>
              <li>Booth in central hall</li>
              <li>General networking access</li>
              <li>2 full-access tickets</li>
            </ul>
          </div>

          <div class="tier-card tier-contributing">
            <span class="tier-badge">Contributing</span>
            <span class="tier-price">$1,250</span>
            <ul class="tier-perks">
              <li>Logo on conference materials &amp; website</li>
              <li>General networking access</li>
              <li>1 full-access ticket</li>
            </ul>
          </div>

          <div class="tier-card tier-friend">
            <span class="tier-badge">Friend</span>
            <span class="tier-price">$500</span>
            <ul class="tier-perks">
              <li>Logo on conference website</li>
              <li>1 full-access ticket</li>
            </ul>
          </div>
        </div>

        <!-- Comparison table -->
        <div class="reveal table-wrap">
          <h2 class="table-heading">Full Comparison</h2>
          <div class="table-scroll">
            <table class="benefit-table">
              <thead>
                <tr>
                  <th class="col-benefit">Benefit</th>
                  <th>Presented By<br/><span class="th-price">$50k</span></th>
                  <th>Title<br/><span class="th-price">$25k</span></th>
                  <th>Signature<br/><span class="th-price">$12.5k</span></th>
                  <th>Community<br/><span class="th-price">$5k</span></th>
                  <th>Stage<br/><span class="th-price">$2.5k</span></th>
                  <th>Contributing<br/><span class="th-price">$1.25k</span></th>
                  <th>Friend<br/><span class="th-price">$500</span></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>"Presented By" naming</td>
                  <td class="yes">✓</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>Logo on materials</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="note">Web only</td>
                </tr>
                <tr>
                  <td>Booth in central hall</td>
                  <td class="note">Premium</td>
                  <td class="note">Premium</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>Video during transitions</td>
                  <td class="note">90 sec</td>
                  <td class="note">60 sec</td>
                  <td class="note">60 sec</td>
                  <td class="note">Logo</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>Opening address</td>
                  <td class="note">10 min</td>
                  <td class="note">5 min</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>Networking events</td>
                  <td class="note">VIP + All</td>
                  <td class="note">VIP + All</td>
                  <td class="note">All</td>
                  <td class="note">All</td>
                  <td class="note">All</td>
                  <td class="note">All</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>Full-access tickets</td>
                  <td class="note">10</td>
                  <td class="note">8</td>
                  <td class="note">6</td>
                  <td class="note">4</td>
                  <td class="note">2</td>
                  <td class="note">1</td>
                  <td class="note">1</td>
                </tr>
                <tr>
                  <td>Social media spotlight</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>Newsletter feature</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
                <tr>
                  <td>2027 first right of refusal</td>
                  <td class="yes">✓</td>
                  <td class="yes">✓</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                  <td class="no">—</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="reveal cta-block">
          <h3 class="cta-heading">Ready to partner with us?</h3>
          <p class="cta-text">We'd love to discuss how your organization can be part of Juneteenth Conference 2026.</p>
          <a href="mailto:info@juneteenthconf.com?subject=Sponsorship%20Inquiry" class="cta-primary" style="margin-top: 20px; display: inline-block;">Get in Touch</a>
        </div>

      </div>
    </div>
  </section>
</InteriorLayout>

<style>
  .interior-section {
    padding: 60px 24px 80px;
    background: #231c2d;
  }
  .interior-content {
    max-width: 1000px; margin: 0 auto;
  }
  .section-lede {
    font-family: 'Inter', sans-serif;
    font-size: clamp(17px, 2vw, 20px);
    color: rgba(240, 237, 230, 0.7);
    line-height: 1.8; margin-bottom: 24px;
  }
  .donation-note {
    font-family: 'Inter', sans-serif;
    font-size: 14px; color: rgba(240, 237, 230, 0.45);
    line-height: 1.7; margin-bottom: 56px;
    padding: 16px 20px;
    border-left: 3px solid rgba(212, 168, 67, 0.3);
    background: rgba(45, 36, 56, 0.3);
    border-radius: 0 6px 6px 0;
  }

  /* Featured tiers */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }

  /* Supporting tiers */
  .supporting-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 56px;
  }

  .tier-card {
    background: rgba(45, 36, 56, 0.4);
    border: 1px solid rgba(240, 237, 230, 0.08);
    border-radius: 10px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
  }
  .tier-presented {
    border-color: rgba(212, 168, 67, 0.5);
    background: rgba(212, 168, 67, 0.05);
  }
  .tier-title {
    border-color: rgba(212, 168, 67, 0.3);
  }
  .tier-signature {
    border-color: rgba(200, 67, 66, 0.25);
  }

  .tier-badge {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 11px;
    color: #D4A843; text-transform: uppercase;
    letter-spacing: 0.15em; display: block; margin-bottom: 8px;
  }
  .tier-price {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 36px;
    color: #f0ede6; display: block; margin-bottom: 20px;
    line-height: 1;
  }
  .featured-grid .tier-price { font-size: 42px; }

  .tier-perks {
    list-style: none; padding: 0; margin: 0 0 24px;
    flex: 1;
  }
  .tier-perks li {
    font-family: 'Inter', sans-serif;
    font-size: 13px; color: rgba(240, 237, 230, 0.55);
    line-height: 1.6; padding: 5px 0 5px 16px;
    position: relative;
    border-bottom: 1px solid rgba(240, 237, 230, 0.04);
  }
  .tier-perks li:last-child { border-bottom: none; }
  .tier-perks li::before {
    content: ''; position: absolute; left: 0; top: 13px;
    width: 5px; height: 5px; border-radius: 50%;
    background: rgba(212, 168, 67, 0.5);
  }

  .tier-cta {
    display: block; text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.05em; text-transform: uppercase;
    color: #D4A843; text-decoration: none;
    border: 1px solid rgba(212, 168, 67, 0.4);
    border-radius: 6px; padding: 10px 0;
    transition: background 0.2s, border-color 0.2s;
    margin-top: auto;
  }
  .tier-cta:hover {
    background: rgba(212, 168, 67, 0.1);
    border-color: #D4A843;
  }

  /* Comparison table */
  .table-wrap { margin-bottom: 56px; }
  .table-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 20px;
    color: rgba(240, 237, 230, 0.5);
    text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: 20px;
  }
  .table-scroll { overflow-x: auto; }
  .benefit-table {
    width: 100%; border-collapse: collapse;
    font-family: 'Inter', sans-serif;
    font-size: 13px; min-width: 700px;
  }
  .benefit-table th {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: rgba(240, 237, 230, 0.5);
    padding: 12px 10px;
    text-align: center;
    border-bottom: 1px solid rgba(240, 237, 230, 0.1);
    white-space: nowrap;
  }
  .benefit-table th.col-benefit { text-align: left; min-width: 180px; }
  .th-price {
    font-weight: 400; color: rgba(240, 237, 230, 0.3);
    text-transform: none; letter-spacing: 0;
  }
  .benefit-table td {
    padding: 10px 10px;
    text-align: center;
    color: rgba(240, 237, 230, 0.4);
    border-bottom: 1px solid rgba(240, 237, 230, 0.04);
  }
  .benefit-table td:first-child {
    text-align: left;
    color: rgba(240, 237, 230, 0.6);
  }
  .benefit-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }
  td.yes { color: #55ac64; font-weight: 600; }
  td.no { color: rgba(240, 237, 230, 0.15); }
  td.note { color: rgba(240, 237, 230, 0.6); font-size: 12px; }

  .cta-block { text-align: center; padding-top: 16px; }
  .cta-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 24px;
    color: #f0ede6; margin-bottom: 12px;
  }
  .cta-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px; color: rgba(240, 237, 230, 0.55);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .featured-grid { grid-template-columns: 1fr; }
    .supporting-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .supporting-grid { grid-template-columns: 1fr; }
  }
</style>

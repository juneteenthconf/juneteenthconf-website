</InteriorLayout>

<style>
  .interior-section {
    padding: 60px 24px 80px;
    background: #231c2d;
  }
  .interior-content {
    max-width: 1000px; margin: 0 auto;
  }
  .section-lede {
    font-family: 'Inter', sans-serif;
    font-size: clamp(17px, 2vw, 20px);
    color: rgba(240, 237, 230, 0.7);
    line-height: 1.8; margin-bottom: 24px;
  }

    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .content-block:last-child { border-bottom: none; }
  .content-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 22px;
